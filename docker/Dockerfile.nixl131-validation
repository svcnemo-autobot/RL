FROM 766267172432.dkr.ecr.us-east-1.amazonaws.com/nemo-autobot/agent-sandbox@sha256:5e21178a97cd3a57386f2fbd02e034818ee53f8e7757a418f9df59e204d54d55
USER 65532:65532
RUN set -eux; \
    for python in /opt/nemo_rl_venv/bin/python /opt/ray_venvs/*/bin/python; do \
        uv pip install --python "$python" --no-deps nixl==1.3.1 nixl-cu12==1.3.1 nixl-cu13==1.3.1; \
        "$python" -c 'import importlib.metadata as m; assert all(m.version(n) == "1.3.1" for n in ("nixl", "nixl-cu12", "nixl-cu13"))'; \
    done; \
    /opt/nemo_rl_venv/bin/python -c 'import nixl'; \
    /opt/nemo_rl_venv/bin/python -c 'import nixl_cu12._bindings'; \
    /opt/nemo_rl_venv/bin/python -c 'import nixl_cu13._bindings'; \
    test -w "$UV_CACHE_DIR"; \
    test -w /opt/nemo_rl_venv
